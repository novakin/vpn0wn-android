<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="WireGuardTheme.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/tunnl_paper_2</item>
        <item name="titleTextColor">@color/tunnl_ink</item>
        <item name="subtitleTextColor">@color/tunnl_ink_3</item>
    </style>

    <style name="AppThemeBase" parent="WireGuardTheme">
        <item name="materialCardViewStyle">@style/WireGuardTheme.MaterialCardView</item>
        <item name="textInputStyle">@style/WireGuardTheme.TextInputLayout</item>
        <item name="materialButtonStyle">@style/WireGuardTheme.MaterialButton</item>
        <item name="toolbarStyle">@style/WireGuardTheme.Toolbar</item>
        <item name="bottomSheetDialogTheme">@style/WireGuardTheme.BottomSheetDialog</item>
        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:navigationBarColor">@color/tunnl_paper</item>
        <item name="colorControlHighlight">@color/tunnl_paper_3</item>
        <item name="fontFamily">@font/inter_tight</item>
        <item name="android:fontFamily">@font/inter_tight</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
    </style>

    <!-- Various additional API-specific features in values-v*/styles.xml -->
    <style name="AppTheme" parent="AppThemeBase" />

    <style name="WireGuardTheme.MaterialCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/tunnl_paper_2</item>
        <item name="cardElevation">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/tunnl_rule</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">12dp</item>
    </style>

    <style name="WireGuardTheme.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/tunnl_paper</item>
        <item name="boxStrokeColor">@color/tunnl_rule_strong</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextColor">@color/tunnl_ink_3</item>
        <item name="helperTextTextColor">@color/tunnl_ink_3</item>
        <item name="errorTextColor">@color/tunnl_error</item>
    </style>

    <style name="WireGuardTheme.MaterialButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/tunnl_paper_2</item>
        <item name="cornerRadius">6dp</item>
        <item name="iconTint">@color/tunnl_signal</item>
        <item name="rippleColor">@color/tunnl_paper_3</item>
        <item name="strokeColor">@color/tunnl_rule</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/tunnl_ink</item>
    </style>

    <style name="TunnlLabelText">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/tunnl_ink_3</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TunnlMonoValueText">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:textColor">@color/tunnl_ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TunnlMonoSubText">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:textColor">@color/tunnl_ink_3</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TunnlFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/tunnl_paper</item>
        <item name="chipStrokeColor">@color/tunnl_rule_strong</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:textColor">@color/tunnl_ink_2</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">@color/tunnl_paper_3</item>
    </style>

    <style name="WireGuardTheme.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="NoBackgroundTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="TvTheme" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
