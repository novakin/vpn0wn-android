<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="Vpn0wnTheme.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/vpn0wn_paper_2</item>
        <item name="titleTextColor">@color/vpn0wn_ink</item>
        <item name="subtitleTextColor">@color/vpn0wn_ink_3</item>
    </style>

    <style name="AppThemeBase" parent="Vpn0wnTheme">
        <item name="materialCardViewStyle">@style/Vpn0wnTheme.MaterialCardView</item>
        <item name="textInputStyle">@style/Vpn0wnTheme.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Vpn0wnTheme.MaterialButton</item>
        <item name="toolbarStyle">@style/Vpn0wnTheme.Toolbar</item>
        <item name="bottomSheetDialogTheme">@style/Vpn0wnTheme.BottomSheetDialog</item>
        <item name="android:windowBackground">@color/vpn0wn_paper_2</item>
        <item name="android:statusBarColor">@color/vpn0wn_paper_2</item>
        <item name="android:navigationBarColor">@color/vpn0wn_paper</item>
        <item name="colorControlHighlight">@color/vpn0wn_paper_3</item>
        <item name="fontFamily">@font/inter_tight</item>
        <item name="android:fontFamily">@font/inter_tight</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
    </style>

    <!-- Various additional API-specific features in values-v*/styles.xml -->
    <style name="AppTheme" parent="AppThemeBase" />

    <style name="Vpn0wnTheme.MaterialCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/vpn0wn_paper_2</item>
        <item name="cardElevation">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/vpn0wn_rule</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">12dp</item>
    </style>

    <style name="Vpn0wnTheme.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/vpn0wn_paper</item>
        <item name="boxStrokeColor">@color/vpn0wn_rule_strong</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextColor">@color/vpn0wn_ink_3</item>
        <item name="helperTextTextColor">@color/vpn0wn_ink_3</item>
        <item name="errorTextColor">@color/vpn0wn_error</item>
    </style>

    <style name="Vpn0wnTheme.MaterialButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/vpn0wn_paper_2</item>
        <item name="cornerRadius">6dp</item>
        <item name="iconTint">@color/vpn0wn_signal</item>
        <item name="rippleColor">@color/vpn0wn_paper_3</item>
        <item name="strokeColor">@color/vpn0wn_rule</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/vpn0wn_ink</item>
    </style>

    <style name="Vpn0wnLabelText">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:fontFeatureSettings">ss01, zero, tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/vpn0wn_ink_3</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Vpn0wnMonoValueText">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:fontFeatureSettings">ss01, zero, tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/vpn0wn_ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Vpn0wnMonoSubText">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:fontFeatureSettings">ss01, zero, tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/vpn0wn_ink_3</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="Vpn0wnTopBarTitleText" parent="Vpn0wnMonoValueText">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Vpn0wnHomeTopBarTitleText" parent="Vpn0wnTopBarTitleText">
        <item name="android:textSize">@dimen/vpn0wn_home_title_size</item>
    </style>

    <style name="Vpn0wnHomeHeaderText" parent="Vpn0wnMonoSubText">
        <item name="android:fontFamily">@font/inter_tight</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Vpn0wnHomeSecondaryText">
        <item name="android:fontFamily">@font/inter_tight</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/vpn0wn_ink_3</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Vpn0wnHomeConnectionText">
        <item name="android:fontFamily">@font/inter_tight</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Vpn0wnHomeTunnelNameText" parent="Vpn0wnMonoValueText">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Vpn0wnHomeStatValueText" parent="Vpn0wnMonoValueText">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Vpn0wnHomeAddButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:fontFeatureSettings">ss01, zero, tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vpn0wn_signal</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/vpn0wn_paper_2</item>
        <item name="cornerRadius">8dp</item>
        <item name="icon">@drawable/ic_vpn0wn_plus</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">14dp</item>
        <item name="iconTint">@color/vpn0wn_signal</item>
        <item name="strokeColor">@color/vpn0wn_rule</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Vpn0wnStatusStripText" parent="Vpn0wnMonoSubText">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Vpn0wnEmptyStateText" parent="Vpn0wnMonoValueText">
        <item name="android:textColor">@color/vpn0wn_ink_2</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Vpn0wnDetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/vpn0wn_paper_2</item>
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:fontFeatureSettings">ss01, zero, tnum</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/vpn0wn_ink</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Vpn0wnConfigRowLabel" parent="Vpn0wnLabelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Vpn0wnConfigRowValue" parent="Vpn0wnMonoValueText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Vpn0wnEditorField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:fontFeatureSettings">ss01, zero, tnum</item>
        <item name="android:textColor">@color/vpn0wn_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <style name="Vpn0wnEditorFieldReadOnly" parent="Vpn0wnEditorField">
        <item name="android:textColor">@color/vpn0wn_ink_3</item>
        <item name="android:focusable">false</item>
        <item name="android:editable">false</item>
    </style>

    <style name="Vpn0wnPillButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:fontFeatureSettings">ss01, zero, tnum</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vpn0wn_ink_2</item>
        <item name="android:textSize">10sp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeColor">@color/vpn0wn_rule_strong</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Vpn0wnDashedActionButton" parent="Vpn0wnPillButton">
        <item name="android:textColor">@color/vpn0wn_ink_3</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Vpn0wnCheckboxText">
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:fontFeatureSettings">ss01, zero, tnum</item>
        <item name="android:textColor">@color/vpn0wn_ink_3</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Vpn0wnFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/vpn0wn_chip_bg</item>
        <item name="chipStrokeColor">@color/vpn0wn_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:fontFeatureSettings">ss01, zero, tnum</item>
        <item name="android:textColor">@color/vpn0wn_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">@color/vpn0wn_paper_3</item>
    </style>

    <style name="Vpn0wnTheme.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="NoBackgroundTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="TvTheme" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
