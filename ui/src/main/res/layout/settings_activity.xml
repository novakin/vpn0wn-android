<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tunnl_paper_2"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/settings_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tunnl_paper_2"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/settings_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/abc_action_bar_up_description"
                android:padding="15dp"
                app:srcCompat="@drawable/ic_tunnl_chevron_left"
                app:tint="@color/tunnl_ink_2" />

            <TextView
                style="@style/TunnlLabelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/tunnl_settings_subtitle" />
        </LinearLayout>

        <TextView
            style="@style/TunnlTopBarTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tunnl_settings_title"
            android:textColor="@color/tunnl_ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tunnl_rule" />

    <FrameLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/tunnl_paper" />
</LinearLayout>
