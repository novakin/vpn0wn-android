<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.vpn0wn.android.util.ClipboardUtils" />

        <import type="com.vpn0wn.android.widget.KeyInputFilter" />

        <import type="com.vpn0wn.android.widget.NameInputFilter" />

        <variable
            name="fragment"
            type="com.vpn0wn.android.fragment.TunnelEditorFragment" />

        <variable
            name="config"
            type="com.vpn0wn.android.viewmodel.ConfigProxy" />

        <variable
            name="name"
            type="String" />
        <variable
            name="isNew"
            type="boolean" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vpn0wn_paper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/editor_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/vpn0wn_paper_2"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/editor_close_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/cancel"
                        android:onClick="@{fragment::onBackPressed}"
                        android:padding="15dp"
                        app:srcCompat="@drawable/ic_vpn0wn_close"
                        app:tint="@color/vpn0wn_ink_2" />

                    <TextView
                        style="@style/Vpn0wnLabelText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{isNew ? @string/tunnl_editor_create : @string/tunnl_editor_edit}" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editor_save_button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:fontFamily="@font/jetbrains_mono_regular"
                        android:minWidth="64dp"
                        android:onClick="@{fragment::onSavePressed}"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/save"
                        android:textAllCaps="true"
                        android:textColor="@color/vpn0wn_paper"
                        android:textSize="11sp"
                        app:backgroundTint="@color/vpn0wn_ink"
                        app:cornerRadius="6dp"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/editor_title"
                    style="@style/Vpn0wnTopBarTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{isNew ? @string/tunnl_editor_new_tunnel : name}"
                    tools:text="home-lab" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/vpn0wn_rule" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="96dp">

                    <!-- §01 Interface section header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Vpn0wnLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="§01"
                            android:textColor="@color/vpn0wn_rule_strong" />

                        <TextView
                            style="@style/Vpn0wnMonoValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/interface_title"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@color/vpn0wn_rule" />

                        <TextView
                            style="@style/Vpn0wnLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="LOCAL SIDE" />
                    </LinearLayout>

                    <!-- Interface FieldGroup card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardElevation="0dp"
                        app:contentPadding="0dp"
                        app:strokeColor="@color/vpn0wn_rule"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- NAME -->
                            <LinearLayout
                                style="@style/Vpn0wnDetailRow"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Vpn0wnConfigRowLabel"
                                    android:text="NAME" />

                                <EditText
                                    android:id="@+id/interface_name_text"
                                    style="@style/Vpn0wnEditorField"
                                    android:imeOptions="actionNext"
                                    android:inputType="textNoSuggestions|textVisiblePassword"
                                    android:nextFocusDown="@id/private_key_text"
                                    android:nextFocusForward="@id/private_key_text"
                                    android:text="@={name}"
                                    app:filter="@{NameInputFilter.newInstance()}" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/vpn0wn_rule" />

                            <!-- PRIVATE KEY -->
                            <LinearLayout
                                style="@style/Vpn0wnDetailRow"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Vpn0wnConfigRowLabel"
                                    android:text="PRIVATE KEY" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingTop="4dp">

                                    <EditText
                                        android:id="@+id/private_key_text"
                                        style="@style/Vpn0wnEditorField"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:imeOptions="actionNext"
                                        android:inputType="textNoSuggestions|textPassword"
                                        android:nextFocusUp="@id/interface_name_text"
                                        android:nextFocusDown="@id/public_key_text"
                                        android:nextFocusForward="@id/public_key_text"
                                        android:onClick="@{fragment::onKeyClick}"
                                        android:text="@={config.interface.privateKey}"
                                        app:filter="@{KeyInputFilter.newInstance()}"
                                        app:onFocusChange="@{fragment::onKeyFocusChange}" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/private_key_regen_button"
                                        style="@style/Vpn0wnPillButton"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="regen"
                                        android:textColor="@color/vpn0wn_ink_2" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/vpn0wn_rule" />

                            <!-- PUBLIC KEY (read-only) -->
                            <LinearLayout
                                style="@style/Vpn0wnDetailRow"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Vpn0wnConfigRowLabel"
                                    android:text="PUBLIC KEY" />

                                <EditText
                                    android:id="@+id/public_key_text"
                                    style="@style/Vpn0wnEditorFieldReadOnly"
                                    android:hint="@string/hint_generated"
                                    android:imeOptions="actionNext"
                                    android:nextFocusUp="@id/private_key_text"
                                    android:nextFocusDown="@id/addresses_label_text"
                                    android:nextFocusForward="@id/addresses_label_text"
                                    android:onClick="@{ClipboardUtils::copyTextView}"
                                    android:singleLine="true"
                                    android:text="@{config.interface.publicKey}" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/vpn0wn_rule" />

                            <!-- ADDRESSES -->
                            <LinearLayout
                                style="@style/Vpn0wnDetailRow"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Vpn0wnConfigRowLabel"
                                    android:text="ADDRESSES" />

                                <EditText
                                    android:id="@+id/addresses_label_text"
                                    style="@style/Vpn0wnEditorField"
                                    android:imeOptions="actionNext"
                                    android:inputType="textNoSuggestions|textVisiblePassword"
                                    android:nextFocusUp="@id/public_key_text"
                                    android:nextFocusDown="@id/dns_servers_text"
                                    android:nextFocusForward="@id/listen_port_text"
                                    android:text="@={config.interface.addresses}" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/vpn0wn_rule" />

                            <!-- DNS SERVERS -->
                            <LinearLayout
                                style="@style/Vpn0wnDetailRow"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Vpn0wnConfigRowLabel"
                                    android:text="DNS SERVERS" />

                                <EditText
                                    android:id="@+id/dns_servers_text"
                                    style="@style/Vpn0wnEditorField"
                                    android:imeOptions="actionNext"
                                    android:inputType="textNoSuggestions|textVisiblePassword"
                                    android:nextFocusUp="@id/addresses_label_text"
                                    android:nextFocusDown="@id/set_excluded_applications"
                                    android:nextFocusForward="@id/mtu_text"
                                    android:text="@={config.interface.dnsServers}" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/vpn0wn_rule" />

                            <!-- LISTEN PORT + MTU side-by-side -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    style="@style/Vpn0wnDetailRow"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Vpn0wnConfigRowLabel"
                                        android:text="LISTEN PORT" />

                                    <EditText
                                        android:id="@+id/listen_port_text"
                                        style="@style/Vpn0wnEditorField"
                                        android:hint="@string/hint_random"
                                        android:imeOptions="actionNext"
                                        android:inputType="number"
                                        android:nextFocusUp="@id/public_key_text"
                                        android:nextFocusDown="@id/mtu_text"
                                        android:nextFocusForward="@id/dns_servers_text"
                                        android:text="@={config.interface.listenPort}" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/vpn0wn_rule" />

                                <LinearLayout
                                    style="@style/Vpn0wnDetailRow"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Vpn0wnConfigRowLabel"
                                        android:text="MTU" />

                                    <EditText
                                        android:id="@+id/mtu_text"
                                        style="@style/Vpn0wnEditorField"
                                        android:hint="@string/hint_automatic"
                                        android:imeOptions="actionDone"
                                        android:inputType="number"
                                        android:nextFocusUp="@id/listen_port_text"
                                        android:nextFocusDown="@id/set_excluded_applications"
                                        android:nextFocusForward="@id/set_excluded_applications"
                                        android:text="@={config.interface.mtu}" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/vpn0wn_rule" />

                            <!-- EXCLUDED APPS -->
                            <LinearLayout
                                style="@style/Vpn0wnDetailRow"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Vpn0wnConfigRowLabel"
                                        android:text="EXCLUDED APPS" />

                                    <TextView
                                        style="@style/Vpn0wnMonoSubText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@{config.interface.includedApplications.size > 0 ? @plurals/set_included_applications(config.interface.includedApplications.size, config.interface.includedApplications.size) : config.interface.excludedApplications.size > 0 ? @plurals/set_excluded_applications(config.interface.excludedApplications.size, config.interface.excludedApplications.size) : @string/all_applications}"
                                        tools:text="none" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/set_excluded_applications"
                                    style="@style/Vpn0wnPillButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:nextFocusUp="@id/dns_servers_text"
                                    android:nextFocusDown="@id/peers_layout"
                                    android:nextFocusForward="@id/peers_layout"
                                    android:onClick="@{fragment::onRequestSetExcludedIncludedApplications}"
                                    android:text="configure"
                                    android:textColor="@color/vpn0wn_ink_2" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- §02 Peers section header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Vpn0wnLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="§02"
                            android:textColor="@color/vpn0wn_rule_strong" />

                        <TextView
                            style="@style/Vpn0wnMonoValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/peers"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@color/vpn0wn_rule" />
                    </LinearLayout>

                    <!-- Peers list -->
                    <LinearLayout
                        android:id="@+id/peers_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@null"
                        android:orientation="vertical"
                        app:fragment="@{fragment}"
                        app:items="@{config.peers}"
                        app:layout="@{@layout/tunnel_editor_peer}"
                        tools:ignore="UselessLeaf" />

                    <!-- Dashed + ADD PEER button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_peer_button"
                        style="@style/Vpn0wnDashedActionButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@null"
                        android:gravity="center"
                        android:onClick="@{() -> config.addPeer()}"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:text="@string/add_peer" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
