<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.vpn0wn.android.databinding.BindingAdapters" />

        <import type="com.vpn0wn.android.util.ClipboardUtils" />

        <variable
            name="item"
            type="com.vpn0wn.config.Peer" />
        <variable
            name="statistics"
            type="com.vpn0wn.android.backend.Statistics.PeerStats" />
        <variable
            name="diagnostics"
            type="com.vpn0wn.android.model.ObservableTunnel.PeerHandshakeDiagnostics" />
        <variable
            name="diagnosticsAvailable"
            type="boolean" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/vpn0wn_paper_3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/peer_title"
                    style="@style/Vpn0wnLabelText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PEER #01" />

                <TextView
                    style="@style/Vpn0wnLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PSK"
                    android:textColor="@color/vpn0wn_signal_deep"
                    android:visibility="@{item.preSharedKey.isPresent() ? android.view.View.VISIBLE : android.view.View.GONE}" />
            </LinearLayout>

            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="PUBLIC KEY" />

                <TextView
                    android:id="@+id/public_key_text"
                    style="@style/Vpn0wnConfigRowValue"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{BindingAdapters.shortKey(item.publicKey.toBase64)}"
                    tools:text="kLn9iJ…Nx5UI=" />
            </LinearLayout>

            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical"
                android:visibility="@{!item.endpoint.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="ENDPOINT" />

                <TextView
                    android:id="@+id/endpoint_text"
                    style="@style/Vpn0wnConfigRowValue"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{item.endpoint}"
                    tools:text="192.168.0.1:51820" />
            </LinearLayout>

            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical"
                android:visibility="@{item.allowedIps.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="ALLOWED IPS" />

                <TextView
                    android:id="@+id/allowed_ips_text"
                    style="@style/Vpn0wnConfigRowValue"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{item.allowedIps}"
                    tools:text="0.0.0.0/0, ::/0" />
            </LinearLayout>

            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical"
                android:visibility="@{!item.persistentKeepalive.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="KEEPALIVE" />

                <TextView
                    android:id="@+id/persistent_keepalive_text"
                    style="@style/Vpn0wnConfigRowValue"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{@plurals/persistent_keepalive_seconds_unit(item.persistentKeepalive.orElse(0), item.persistentKeepalive.orElse(0))}"
                    tools:text="every 25 seconds" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transfer_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:background="@color/vpn0wn_paper_2"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="@{BindingAdapters.peerTransferVisible(statistics) ? android.view.View.VISIBLE : android.view.View.GONE}"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="4dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Vpn0wnConfigRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vpn0wn_peer_rx_label" />

                    <TextView
                        android:id="@+id/rx_text"
                        style="@style/Vpn0wnMonoValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center_vertical|start"
                        android:contentDescription="@{@string/vpn0wn_peer_rx_label + `: ` + BindingAdapters.peerRx(statistics)}"
                        android:onClick="@{ClipboardUtils::copyTextView}"
                        android:text="@{BindingAdapters.peerRx(statistics)}"
                        android:textSize="13sp"
                        tools:text="19.8 MB" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Vpn0wnConfigRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vpn0wn_peer_tx_label" />

                    <TextView
                        android:id="@+id/tx_text"
                        style="@style/Vpn0wnMonoValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center_vertical|start"
                        android:contentDescription="@{@string/vpn0wn_peer_tx_label + `: ` + BindingAdapters.peerTx(statistics)}"
                        android:onClick="@{ClipboardUtils::copyTextView}"
                        android:text="@{BindingAdapters.peerTx(statistics)}"
                        android:textSize="13sp"
                        tools:text="973 KB" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:id="@+id/latest_handshake_row"
                android:orientation="vertical"
                android:visibility="@{BindingAdapters.peerHandshakeVisible(statistics) ? android.view.View.VISIBLE : android.view.View.GONE}">

                <TextView
                    android:id="@+id/latest_handshake_label"
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="@string/latest_handshake"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/latest_handshake_text"
                    style="@style/Vpn0wnConfigRowValue"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{BindingAdapters.peerHandshake(statistics)}"
                    tools:text="4 minutes ago"
                    tools:visibility="visible" />
            </LinearLayout>
            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="@string/vpn0wn_handshake_observation_label" />

                <TextView
                    android:id="@+id/handshake_observation_text"
                    style="@style/Vpn0wnMonoValueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp"
                    app:peerHandshakeObservation="@{diagnostics.lastObservation}"
                    app:peerHandshakeAvailable="@{diagnosticsAvailable}"
                    tools:text="Initiation sent locally" />
            </LinearLayout>

            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="@string/vpn0wn_observed_endpoint_label" />

                <TextView
                    android:id="@+id/observed_endpoint_text"
                    style="@style/Vpn0wnMonoValueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp"
                    android:textDirection="ltr"
                    android:text="@{BindingAdapters.observedHandshakeEndpoint(diagnostics.lastObservation)}"
                    tools:text="[2001:db8:1234:5678::abcd]:51820" />
            </LinearLayout>

            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="@string/vpn0wn_observed_address_family_label" />

                <TextView
                    android:id="@+id/observed_address_family_text"
                    style="@style/Vpn0wnMonoValueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp"
                    android:text="@{BindingAdapters.observedHandshakeAddressFamily(diagnostics.lastObservation)}"
                    tools:text="IPv6" />

                <TextView
                    style="@style/Vpn0wnMonoSubText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/vpn0wn_handshake_observation_scope" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
