<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.wireguard.android.databinding.BindingAdapters" />

        <import type="com.wireguard.android.util.ClipboardUtils" />

        <variable
            name="item"
            type="com.wireguard.config.Peer" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/tunnl_paper_3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/peer_title"
                    style="@style/TunnlLabelText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PEER #01" />

                <TextView
                    style="@style/TunnlLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PSK"
                    android:textColor="@color/tunnl_signal_deep"
                    android:visibility="@{item.preSharedKey.isPresent() ? android.view.View.VISIBLE : android.view.View.GONE}" />
            </LinearLayout>

            <LinearLayout
                style="@style/TunnlDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/TunnlConfigRowLabel"
                    android:text="PUBLIC KEY" />

                <TextView
                    android:id="@+id/public_key_text"
                    style="@style/TunnlConfigRowValue"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{BindingAdapters.shortKey(item.publicKey.toBase64)}"
                    tools:text="kLn9iJ…Nx5UI=" />
            </LinearLayout>

            <LinearLayout
                style="@style/TunnlDetailRow"
                android:orientation="vertical"
                android:visibility="@{!item.endpoint.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">

                <TextView
                    style="@style/TunnlConfigRowLabel"
                    android:text="ENDPOINT" />

                <TextView
                    android:id="@+id/endpoint_text"
                    style="@style/TunnlConfigRowValue"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{item.endpoint}"
                    tools:text="192.168.0.1:51820" />
            </LinearLayout>

            <LinearLayout
                style="@style/TunnlDetailRow"
                android:orientation="vertical"
                android:visibility="@{item.allowedIps.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}">

                <TextView
                    style="@style/TunnlConfigRowLabel"
                    android:text="ALLOWED IPS" />

                <TextView
                    android:id="@+id/allowed_ips_text"
                    style="@style/TunnlConfigRowValue"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{item.allowedIps}"
                    tools:text="0.0.0.0/0, ::/0" />
            </LinearLayout>

            <LinearLayout
                style="@style/TunnlDetailRow"
                android:orientation="vertical"
                android:visibility="@{!item.persistentKeepalive.isPresent() ? android.view.View.GONE : android.view.View.VISIBLE}">

                <TextView
                    style="@style/TunnlConfigRowLabel"
                    android:text="KEEPALIVE" />

                <TextView
                    android:id="@+id/persistent_keepalive_text"
                    style="@style/TunnlConfigRowValue"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:text="@{@plurals/persistent_keepalive_seconds_unit(item.persistentKeepalive.orElse(0), item.persistentKeepalive.orElse(0))}"
                    tools:text="every 25 seconds" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/transfer_label"
                        style="@style/TunnlConfigRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/tunnl_paper_2"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:text="@string/transfer"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/transfer_text"
                        style="@style/TunnlMonoValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/tunnl_paper_2"
                        android:onClick="@{ClipboardUtils::copyTextView}"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="rx: 19.8 MB, tx: 973 KB"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/latest_handshake_label"
                        style="@style/TunnlConfigRowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/tunnl_paper_2"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:text="@string/latest_handshake"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/latest_handshake_text"
                        style="@style/TunnlMonoValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/tunnl_paper_2"
                        android:onClick="@{ClipboardUtils::copyTextView}"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="4 minutes ago"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
