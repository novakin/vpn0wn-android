<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tunnl_paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Filter bar: scrollable chips + fixed LIVE/PAUSED toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tunnl_paper_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/filter_scroller"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filter_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp"
                app:checkedChip="@id/filter_all"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_all"
                    style="@style/TunnlFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALL" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_verbose"
                    style="@style/TunnlFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VERBOSE" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_debug"
                    style="@style/TunnlFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEBUG" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_info"
                    style="@style/TunnlFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFO" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_warn"
                    style="@style/TunnlFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WARN" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_error"
                    style="@style/TunnlFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ERROR" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_fatal"
                    style="@style/TunnlFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FATAL" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/live_toggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/jetbrains_mono_medium"
            android:text="◆ LIVE"
            android:textColor="@color/tunnl_signal_deep"
            android:textSize="10sp"
            app:strokeColor="@color/tunnl_rule_strong"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tunnl_rule" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/tunnl_paper"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        tools:itemCount="20"
        tools:listitem="@layout/log_viewer_entry" />

</LinearLayout>
