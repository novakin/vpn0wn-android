<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.vpn0wn.android.model.ObservableTunnel" />

        <import type="com.vpn0wn.android.databinding.BindingAdapters" />

        <variable
            name="collection"
            type="com.vpn0wn.android.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />

        <variable
            name="key"
            type="String" />

        <variable
            name="item"
            type="com.vpn0wn.android.model.ObservableTunnel" />

        <variable
            name="fragment"
            type="com.vpn0wn.android.fragment.TunnelListFragment" />

        <variable name="selectionMode" type="boolean" />
        <variable name="selected" type="boolean" />
    </data>

    <com.vpn0wn.android.widget.MultiselectableRelativeLayout
        android:id="@+id/tunnel_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/tunnl_list_item_background"
        android:contentDescription="@{selectionMode ? item.name : null}"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:nextFocusRight="@+id/tunnel_switch"
        android:padding="0dp">

        <View
            android:id="@+id/active_rail"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_above="@id/tunnel_stats"
            app:tunnelRailTunnel="@{item}"
            app:tunnelRailState="@{item.state}"
            app:tunnelRailStatistics="@{item.statistics}" />

        <com.vpn0wn.android.widget.ToggleSwitch
            android:id="@+id/tunnel_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="14dp"
            android:nextFocusLeft="@+id/tunnel_list_item"
            android:visibility="@{selectionMode ? android.view.View.GONE : android.view.View.VISIBLE}"
            app:onBeforeCheckedChanged="@{fragment::setTunnelState}"
            app:tunnelSwitchModeTunnel="@{item}"
            app:tunnelSwitchModeState="@{item.state}"
            app:tunnelSwitchModeStatistics="@{item.statistics}"
            tools:checked="@sample/interface_names.json/names/checked/checked" />

        <ImageView
            android:id="@+id/selection_checkbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="14dp"
            android:layout_marginTop="28dp"
            android:importantForAccessibility="no"
            android:src="@{selected ? @drawable/tunnl_selection_checkbox_checked : @drawable/tunnl_selection_checkbox_unchecked}"
            android:visibility="@{selectionMode ? android.view.View.VISIBLE : android.view.View.GONE}" />

        <LinearLayout
            android:id="@+id/tunnel_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="13dp"
            android:layout_toStartOf="@id/tunnel_switch"
            app:tunnelSelectionInset="@{selectionMode}"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tunnel_peer_badge"
                style="@style/Vpn0wnHomeSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                app:tunnelStatusTunnel="@{item}"
                app:tunnelStatusState="@{item.state}"
                app:tunnelStatusStatistics="@{item.statistics}"
                app:tunnelStatusConfig="@{item.config}"
                tools:text="◆ ACTIVE · ChaCha20 + PSK" />

            <TextView
                android:id="@+id/tunnel_name"
                style="@style/Vpn0wnHomeTunnelNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{key}"
                tools:text="@sample/interface_names.json/names/names/name" />

            <TextView
                style="@style/Vpn0wnMonoSubText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{BindingAdapters.tunnelRoute(item.config)}"
                android:textSize="11sp"
                tools:text="172.20.4.18/24 -> gw.example.ro:51820" />
        </LinearLayout>

        <com.vpn0wn.android.widget.TunnelSignalView
            android:id="@+id/tunnel_signal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_below="@id/tunnel_header"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            app:tunnelSignalTunnel="@{item}"
            app:tunnelSignalState="@{item.state}"
            app:tunnelSignalStatistics="@{item.statistics}" />

        <LinearLayout
            android:id="@+id/tunnel_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tunnel_signal"
            android:layout_marginStart="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/tunnl_list_item_stats_background"
            android:orientation="vertical"
            android:visibility="@{BindingAdapters.tunnelStatsVisible(item, item.state, item.statistics) ? android.view.View.VISIBLE : android.view.View.GONE}">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tunnl_rule" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        style="@style/Vpn0wnLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vpn0wn_in" />

                    <TextView
                        style="@style/Vpn0wnHomeStatValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@{BindingAdapters.tunnelRx(item.statistics)}"
                        tools:text="19.8 MB" />

                    <TextView
                        style="@style/Vpn0wnMonoSubText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{BindingAdapters.tunnelRxRate(item, item.statistics)}"
                        tools:text="343 KB/s" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/tunnl_rule" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        style="@style/Vpn0wnLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vpn0wn_out" />

                    <TextView
                        style="@style/Vpn0wnHomeStatValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@{BindingAdapters.tunnelTx(item.statistics)}"
                        tools:text="973 KB" />

                    <TextView
                        style="@style/Vpn0wnMonoSubText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{BindingAdapters.tunnelTxRate(item, item.statistics)}"
                        tools:text="29 KB/s" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/tunnl_rule" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        style="@style/Vpn0wnLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vpn0wn_last_handshake" />

                    <TextView
                        style="@style/Vpn0wnHomeStatValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        app:homeHandshakeStatistics="@{item.statistics}"
                        tools:text="2m 32s ago" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.vpn0wn.android.widget.MultiselectableRelativeLayout>
</layout>
