<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tunnl_paper_2"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/log_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/tunnl_ink_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Fri Mar 13 10:17:37 GMT+05:30 2020" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/log_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/tunnl_ink"
        app:layout_constraintTop_toBottomOf="@id/log_date"
        tools:text="FATAL EXCEPTION: Thread-2" />

</androidx.constraintlayout.widget.ConstraintLayout>
