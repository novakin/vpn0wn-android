<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vpn0wn_paper"
    android:orientation="horizontal">

    <!-- 2dp left severity border: warn=vpn0wn_warn, error=vpn0wn_error, else transparent (set in code) -->
    <View
        android:id="@+id/level_border"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="12dp"
        android:paddingBottom="3dp">

        <!-- HH:MM:SS.mmm -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/log_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:textColor="@color/vpn0wn_ink_3"
            android:textSize="11sp"
            tools:text="10:17:37.886" />

        <!-- D / I / W / E / V / F (colored per level) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/log_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/jetbrains_mono_medium"
            android:minWidth="12dp"
            android:textSize="11sp"
            tools:text="D"
            tools:textColor="@color/vpn0wn_ink_3" />

        <!-- Tag (ink_3, min width for alignment) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/log_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:minWidth="80dp"
            android:textColor="@color/vpn0wn_ink_3"
            android:textSize="11sp"
            tools:text="WireGuard" />

        <!-- Message (ink, fills remaining width, tap to expand) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/log_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:textColor="@color/vpn0wn_ink"
            android:textSize="11sp"
            tools:text="Starting tunnel..." />

    </LinearLayout>
</LinearLayout>
