<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.wireguard.android.backend.Tunnel.State" />

        <import type="com.wireguard.android.databinding.BindingAdapters" />

        <import type="com.wireguard.android.util.ClipboardUtils" />

        <variable
            name="fragment"
            type="com.wireguard.android.fragment.TunnelDetailFragment" />

        <variable
            name="tunnel"
            type="com.wireguard.android.model.ObservableTunnel" />

        <variable
            name="config"
            type="com.wireguard.config.Config" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tunnl_paper"
        android:clipToPadding="false"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="96dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tunnel_schematic_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:strokeColor="@color/tunnl_rule">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TunnlLabelText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="FIG.01 - TUNNEL TOPOLOGY" />

                        <TextView
                            style="@style/TunnlLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{tunnel.state == State.UP ? `UP` : `DOWN`}"
                            android:textColor="@{tunnel.state == State.UP ? @color/tunnl_signal_deep : @color/tunnl_ink_3}"
                            tools:text="UP" />
                    </LinearLayout>

                    <com.wireguard.android.widget.TunnelThroughputView
                        android:id="@+id/throughput_view"
                        android:layout_width="match_parent"
                        android:layout_height="206dp"
                        android:layout_marginTop="8dp"
                        app:isUp="@{tunnel.state == State.UP}"
                        app:isConnecting="@{tunnel.state == State.TOGGLE}"
                        app:topologyConfig="@{config}"
                        app:trafficStatistics="@{tunnel.statistics}"
                        app:trafficTunnel="@{tunnel}" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TunnlMonoSubText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{BindingAdapters.tunnelRoute(config)}"
                            tools:text="172.20.4.18/24 -> gw.example.ro:51820" />

                        <TextView
                            style="@style/TunnlLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@{BindingAdapters.tunnelPeerBadge(config)}"
                            android:textColor="@color/tunnl_signal_deep"
                            tools:text="PSK" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tunnel_status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:strokeColor="@{tunnel.state == State.UP ? @color/tunnl_signal_deep : @color/tunnl_rule}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/tunnl_active_rail" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TunnlLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{tunnel.state == State.UP ? `TUNNEL UP` : `TUNNEL DOWN`}"
                            android:textColor="@{tunnel.state == State.UP ? @color/tunnl_signal_deep : @color/tunnl_ink_3}"
                            tools:text="TUNNEL UP" />

                        <TextView
                            style="@style/TunnlMonoSubText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@{tunnel.state == State.UP ? BindingAdapters.tunnelHandshake(tunnel.statistics) : `tap to bring up`}"
                            tools:text="2m 32s ago" />
                    </LinearLayout>

                    <com.wireguard.android.widget.ToggleSwitch
                        android:id="@+id/tunnel_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:checked="@{tunnel.state == State.UP}"
                        app:onBeforeCheckedChanged="@{fragment::setTunnelState}" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="@{tunnel.state == State.UP ? android.view.View.VISIBLE : android.view.View.GONE}">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:strokeColor="@color/tunnl_signal_deep">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TunnlLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↓ DOWNLOAD" />

                        <TextView
                            style="@style/TunnlMonoValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@{BindingAdapters.tunnelRx(tunnel.statistics)}"
                            android:textSize="20sp"
                            tools:text="19.8 MB" />

                        <TextView
                            style="@style/TunnlMonoSubText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{BindingAdapters.tunnelRxRate(tunnel, tunnel.statistics)}"
                            android:textColor="@color/tunnl_signal_deep"
                            android:textSize="11sp"
                            tools:text="343 KB/S" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TunnlLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↑ UPLOAD" />

                        <TextView
                            style="@style/TunnlMonoValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@{BindingAdapters.tunnelTx(tunnel.statistics)}"
                            android:textSize="20sp"
                            tools:text="973 KB" />

                        <TextView
                            style="@style/TunnlMonoSubText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{BindingAdapters.tunnelTxRate(tunnel, tunnel.statistics)}"
                            android:textSize="11sp"
                            tools:text="29 KB/S" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TunnlLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="§01"
                    android:textColor="@color/tunnl_rule_strong" />

                <TextView
                    style="@style/TunnlMonoValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/interface_title"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/tunnl_rule" />

                <TextView
                    style="@style/TunnlLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@{config.interface.mtu.isPresent() ? `MTU ` + config.interface.mtu.get() : ``}"
                    tools:text="MTU 1420" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tunnel_detail_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/TunnlDetailRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TunnlConfigRowLabel"
                            android:text="NAME" />

                        <TextView
                            android:id="@+id/interface_name_text"
                            style="@style/TunnlConfigRowValue"
                            android:onClick="@{ClipboardUtils::copyTextView}"
                            android:text="@{tunnel.name}"
                            tools:text="office-ro" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/TunnlDetailRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TunnlConfigRowLabel"
                            android:text="PUBLIC KEY" />

                        <TextView
                            android:id="@+id/public_key_text"
                            style="@style/TunnlConfigRowValue"
                            android:maxLines="1"
                            android:onClick="@{ClipboardUtils::copyTextView}"
                            android:text="@{BindingAdapters.shortKey(config.interface.keyPair.publicKey.toBase64)}"
                            tools:text="wOs2…BVkA" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/TunnlDetailRow"
                        android:orientation="vertical"
                        android:visibility="@{config.interface.addresses.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}">

                        <TextView
                            style="@style/TunnlConfigRowLabel"
                            android:text="ADDRESSES" />

                        <TextView
                            android:id="@+id/addresses_text"
                            style="@style/TunnlConfigRowValue"
                            android:onClick="@{ClipboardUtils::copyTextView}"
                            android:text="@{config.interface.addresses}"
                            tools:text="172.20.4.18/24" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/TunnlDetailRow"
                        android:orientation="vertical"
                        android:visibility="@{config.interface.dnsServers.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}">

                        <TextView
                            style="@style/TunnlConfigRowLabel"
                            android:text="DNS SERVERS" />

                        <TextView
                            android:id="@+id/dns_servers_text"
                            style="@style/TunnlConfigRowValue"
                            android:onClick="@{ClipboardUtils::copyTextView}"
                            android:text="@{config.interface.dnsServers}"
                            tools:text="1.1.1.1" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/TunnlDetailRow"
                        android:orientation="vertical"
                        android:visibility="@{config.interface.dnsSearchDomains.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}">

                        <TextView
                            style="@style/TunnlConfigRowLabel"
                            android:text="DNS SEARCH DOMAINS" />

                        <TextView
                            android:id="@+id/dns_search_domains_text"
                            style="@style/TunnlConfigRowValue"
                            android:onClick="@{ClipboardUtils::copyTextView}"
                            android:text="@{config.interface.dnsSearchDomains}"
                            tools:text="corp.example" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/listen_port_mtu_barrier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            style="@style/TunnlDetailRow"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TunnlConfigRowLabel"
                                android:text="LISTEN PORT" />

                            <TextView
                                android:id="@+id/listen_port_text"
                                style="@style/TunnlConfigRowValue"
                                android:onClick="@{ClipboardUtils::copyTextView}"
                                android:text="@{config.interface.listenPort.isPresent() ? config.interface.listenPort.get().toString() : `—`}"
                                tools:text="51820" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/TunnlDetailRow"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TunnlConfigRowLabel"
                                android:text="MTU" />

                            <TextView
                                android:id="@+id/mtu_text"
                                style="@style/TunnlConfigRowValue"
                                android:onClick="@{ClipboardUtils::copyTextView}"
                                android:text="@{config.interface.mtu.isPresent() ? config.interface.mtu.get().toString() : `—`}"
                                tools:text="1420" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        style="@style/TunnlDetailRow"
                        android:orientation="vertical"
                        android:visibility="@{config.interface.includedApplications.isEmpty() &amp;&amp; config.interface.excludedApplications.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TunnlConfigRowLabel"
                            android:text="@{config.interface.excludedApplications.isEmpty() ? `INCLUDED APPS · ` + config.interface.includedApplications.size() : `EXCLUDED APPS · ` + config.interface.excludedApplications.size()}"
                            tools:text="EXCLUDED APPS · 2" />

                        <TextView
                            android:id="@+id/applications_text"
                            style="@style/TunnlConfigRowValue"
                            android:onClick="@{ClipboardUtils::copyTextView}"
                            android:text="@{config.interface.includedApplications.isEmpty() ? @plurals/n_excluded_applications(config.interface.excludedApplications.size(), config.interface.excludedApplications.size()) : @plurals/n_included_applications(config.interface.includedApplications.size(), config.interface.includedApplications.size())}"
                            tools:text="2 excluded" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TunnlLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="§02"
                    android:textColor="@color/tunnl_rule_strong" />

                <TextView
                    style="@style/TunnlMonoValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/peers"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/tunnl_rule" />

                <TextView
                    style="@style/TunnlLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@{@plurals/n_peers(config.peers.size(), config.peers.size())}" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/peers_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:divider="@null"
                android:orientation="vertical"
                app:items="@{config.peers}"
                app:layout="@{@layout/tunnel_detail_peer}"
                tools:ignore="UselessLeaf" />
        </LinearLayout>
    </ScrollView>
</layout>
