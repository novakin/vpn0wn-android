<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.vpn0wn.android.databinding.BindingAdapters" />

        <variable
            name="fragment"
            type="com.vpn0wn.android.fragment.TunnelDetailFragment" />

        <variable
            name="tunnel"
            type="com.vpn0wn.android.model.ObservableTunnel" />

        <variable
            name="config"
            type="com.vpn0wn.config.Config" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vpn0wn_paper"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/detail_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/vpn0wn_paper_2"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/detail_back_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/vpn0wn_navigate_back"
                    android:onClick="@{fragment::onBackPressed}"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_vpn0wn_chevron_left"
                    app:tint="@color/vpn0wn_ink_2" />

                <TextView
                    style="@style/Vpn0wnLabelText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    app:detailTopBarSubtitleTunnel="@{tunnel}"
                    tools:text="TUNNEL · HOME-LAB" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vpn0wnTopBarTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{tunnel.name}"
                    tools:text="home-lab" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/detail_edit_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/edit"
                    android:onClick="@{fragment::onEditPressed}"
                    android:padding="15dp"
                    app:srcCompat="@drawable/ic_action_edit"
                    app:tint="@color/vpn0wn_ink_2" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/vpn0wn_rule" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/vpn0wn_paper"
            android:clipToPadding="false"
            android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="96dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tunnel_schematic_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:strokeColor="@color/vpn0wn_rule">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Vpn0wnLabelText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/vpn0wn_tunnel_topology" />

                        <TextView
                            style="@style/Vpn0wnLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:detailTopologyStatusTunnel="@{tunnel}"
                            app:detailTopologyStatusState="@{tunnel.state}"
                            app:detailTopologyStatusStatistics="@{tunnel.statistics}"
                            tools:text="UP" />
                    </LinearLayout>

                    <com.vpn0wn.android.widget.TunnelThroughputView
                        android:id="@+id/throughput_view"
                        android:layout_width="match_parent"
                        android:layout_height="206dp"
                        android:layout_marginTop="8dp"
                        app:topologyConfig="@{config}"
                        app:trafficStatistics="@{tunnel.statistics}"
                        app:trafficTunnel="@{tunnel}"
                        app:throughputModeTunnel="@{tunnel}"
                        app:throughputModeState="@{tunnel.state}"
                        app:throughputModeStatistics="@{tunnel.statistics}" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Vpn0wnMonoSubText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{BindingAdapters.tunnelRoute(context, config)}"
                            tools:text="172.20.4.18/24 -> gw.example.ro:51820" />

                        <TextView
                            style="@style/Vpn0wnLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@{BindingAdapters.tunnelPeerBadge(context, config)}"
                            android:textColor="@color/vpn0wn_signal_deep"
                            tools:text="PSK" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tunnel_status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:detailStatusStrokeTunnel="@{tunnel}"
                app:detailStatusStrokeState="@{tunnel.state}"
                app:detailStatusStrokeStatistics="@{tunnel.statistics}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginEnd="12dp"
                        app:detailStatusDotTunnel="@{tunnel}"
                        app:detailStatusDotState="@{tunnel.state}"
                        app:detailStatusDotStatistics="@{tunnel.statistics}" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Vpn0wnLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:detailStatusTitleTunnel="@{tunnel}"
                            app:detailStatusTitleState="@{tunnel.state}"
                            app:detailStatusTitleStatistics="@{tunnel.statistics}"
                            tools:text="TUNNEL UP" />

                        <TextView
                            style="@style/Vpn0wnMonoSubText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            app:detailStatusSubtitleTunnel="@{tunnel}"
                            app:detailStatusSubtitleState="@{tunnel.state}"
                            app:detailStatusSubtitleStatistics="@{tunnel.statistics}"
                            tools:text="2m 32s ago" />
                    </LinearLayout>

                    <com.vpn0wn.android.widget.ToggleSwitch
                        android:id="@+id/tunnel_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:onBeforeCheckedChanged="@{fragment::setTunnelState}"
                        app:tunnelSwitchModeTunnel="@{tunnel}"
                        app:tunnelSwitchModeState="@{tunnel.state}"
                        app:tunnelSwitchModeStatistics="@{tunnel.statistics}" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="@{BindingAdapters.tunnelStatsVisible(tunnel, tunnel.state, tunnel.statistics) ? android.view.View.VISIBLE : android.view.View.GONE}">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:strokeColor="@color/vpn0wn_signal_deep">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Vpn0wnLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vpn0wn_download" />

                        <TextView
                            style="@style/Vpn0wnMonoValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@{BindingAdapters.tunnelRx(tunnel.statistics)}"
                            android:textSize="20sp"
                            tools:text="19.8 MB" />

                        <TextView
                            style="@style/Vpn0wnMonoSubText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{BindingAdapters.tunnelRxRate(tunnel, tunnel.statistics)}"
                            android:textColor="@color/vpn0wn_signal_deep"
                            android:textSize="11sp"
                            tools:text="343 KB/S" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Vpn0wnLabelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vpn0wn_upload" />

                        <TextView
                            style="@style/Vpn0wnMonoValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@{BindingAdapters.tunnelTx(tunnel.statistics)}"
                            android:textSize="20sp"
                            tools:text="973 KB" />

                        <TextView
                            style="@style/Vpn0wnMonoSubText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{BindingAdapters.tunnelTxRate(tunnel, tunnel.statistics)}"
                            android:textSize="11sp"
                            tools:text="29 KB/S" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vpn0wnLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="§01"
                    android:textColor="@color/vpn0wn_rule_strong" />

                <TextView
                    style="@style/Vpn0wnMonoValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/interface_title"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/vpn0wn_rule" />

                <TextView
                    style="@style/Vpn0wnLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@{config.interface.mtu.isPresent() ? `MTU ` + config.interface.mtu.get() : ``}"
                    tools:text="MTU 1420" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tunnel_detail_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/interface_name_row"
                        style="@style/Vpn0wnDetailRow"
                        android:contentDescription="@{@string/tunnel_name + `: ` + (tunnel == null ? `` : tunnel.name)}"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:orientation="vertical"
                        app:copyText="@{tunnel.name}">

                        <TextView
                            style="@style/Vpn0wnConfigRowLabel"
                            android:text="@string/name" />

                        <TextView
                            android:id="@+id/interface_name_text"
                            style="@style/Vpn0wnConfigRowValue"
                            android:text="@{tunnel.name}"
                            tools:text="office-ro" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/public_key_row"
                        style="@style/Vpn0wnDetailRow"
                        android:contentDescription="@string/public_key"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:orientation="vertical"
                        app:copyText="@{config.interface.keyPair.publicKey.toBase64}">

                        <TextView
                            style="@style/Vpn0wnConfigRowLabel"
                            android:text="@string/public_key" />

                        <TextView
                            android:id="@+id/public_key_text"
                            style="@style/Vpn0wnConfigRowValue"
                            android:maxLines="1"
                            android:text="@{BindingAdapters.shortKey(config.interface.keyPair.publicKey.toBase64)}"
                            tools:text="wOs2…BVkA" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/addresses_row"
                        style="@style/Vpn0wnDetailRow"
                        android:contentDescription="@{@string/addresses + `: ` + BindingAdapters.inetNetworksText(config.interface.addresses)}"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:orientation="vertical"
                        android:visibility="@{config.interface.addresses.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}"
                        app:copyText="@{BindingAdapters.inetNetworksText(config.interface.addresses)}">

                        <TextView
                            style="@style/Vpn0wnConfigRowLabel"
                            android:text="@string/addresses" />

                        <TextView
                            android:id="@+id/addresses_text"
                            style="@style/Vpn0wnConfigRowValue"
                            android:text="@{config.interface.addresses}"
                            tools:text="172.20.4.18/24" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dns_servers_row"
                        style="@style/Vpn0wnDetailRow"
                        android:contentDescription="@{@string/dns_servers + `: ` + BindingAdapters.inetAddressesText(config.interface.dnsServers)}"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:orientation="vertical"
                        android:visibility="@{config.interface.dnsServers.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}"
                        app:copyText="@{BindingAdapters.inetAddressesText(config.interface.dnsServers)}">

                        <TextView
                            style="@style/Vpn0wnConfigRowLabel"
                            android:text="@string/dns_servers" />

                        <TextView
                            android:id="@+id/dns_servers_text"
                            style="@style/Vpn0wnConfigRowValue"
                            android:text="@{config.interface.dnsServers}"
                            tools:text="1.1.1.1" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dns_search_domains_row"
                        style="@style/Vpn0wnDetailRow"
                        android:contentDescription="@{@string/dns_search_domains + `: ` + BindingAdapters.stringsText(config.interface.dnsSearchDomains)}"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:orientation="vertical"
                        android:visibility="@{config.interface.dnsSearchDomains.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}"
                        app:copyText="@{BindingAdapters.stringsText(config.interface.dnsSearchDomains)}">

                        <TextView
                            style="@style/Vpn0wnConfigRowLabel"
                            android:text="@string/dns_search_domains" />

                        <TextView
                            android:id="@+id/dns_search_domains_text"
                            style="@style/Vpn0wnConfigRowValue"
                            android:text="@{config.interface.dnsSearchDomains}"
                            tools:text="corp.example" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/listen_port_mtu_barrier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/listen_port_row"
                            style="@style/Vpn0wnDetailRow"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@{@string/listen_port + `: ` + BindingAdapters.optionalText(config.interface.listenPort, `—`)}"
                            android:foreground="?attr/selectableItemBackground"
                            android:minHeight="48dp"
                            android:orientation="vertical"
                            app:copyText="@{BindingAdapters.optionalText(config.interface.listenPort, `—`)}">

                            <TextView
                                style="@style/Vpn0wnConfigRowLabel"
                                android:text="@string/listen_port" />

                            <TextView
                                android:id="@+id/listen_port_text"
                                style="@style/Vpn0wnConfigRowValue"
                                android:text="@{BindingAdapters.optionalText(config.interface.listenPort, `—`)}"
                                tools:text="51820" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/mtu_row"
                            style="@style/Vpn0wnDetailRow"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@{@string/mtu + `: ` + BindingAdapters.optionalText(config.interface.mtu, `—`)}"
                            android:foreground="?attr/selectableItemBackground"
                            android:minHeight="48dp"
                            android:orientation="vertical"
                            app:copyText="@{BindingAdapters.optionalText(config.interface.mtu, `—`)}">

                            <TextView
                                style="@style/Vpn0wnConfigRowLabel"
                                android:text="MTU" />

                            <TextView
                                android:id="@+id/mtu_text"
                                style="@style/Vpn0wnConfigRowValue"
                                android:text="@{BindingAdapters.optionalText(config.interface.mtu, `—`)}"
                                tools:text="1420" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/applications_row"
                        style="@style/Vpn0wnDetailRow"
                        android:contentDescription="@{@string/applications + `: ` + BindingAdapters.applicationsText(context, config)}"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:orientation="vertical"
                        android:visibility="@{config.interface.includedApplications.isEmpty() &amp;&amp; config.interface.excludedApplications.isEmpty() ? android.view.View.GONE : android.view.View.VISIBLE}"
                        app:copyText="@{BindingAdapters.applicationsText(context, config)}"
                        tools:visibility="visible">

                        <TextView
                            style="@style/Vpn0wnConfigRowLabel"
                            android:text="@{BindingAdapters.applicationsLabel(context, config)}"
                            tools:text="EXCLUDED APPS · 2" />

                        <TextView
                            android:id="@+id/applications_text"
                            style="@style/Vpn0wnConfigRowValue"
                            android:text="@{BindingAdapters.applicationsText(context, config)}"
                            tools:text="2 excluded" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vpn0wnLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="§02"
                    android:textColor="@color/vpn0wn_rule_strong" />

                <TextView
                    style="@style/Vpn0wnMonoValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/peers"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/vpn0wn_rule" />

                <TextView
                    style="@style/Vpn0wnLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@{@plurals/n_peers(config.peers.size(), config.peers.size())}" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/peers_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:divider="@null"
                android:orientation="vertical"
                app:detailPeers="@{config.peers}"
                app:detailPeerDiagnostics="@{tunnel.handshakeDiagnostics}"
                app:detailPeerState="@{tunnel.state}"
                tools:ignore="UselessLeaf" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vpn0wnLabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="§03"
                    android:textColor="@color/vpn0wn_rule_strong" />

                <TextView
                    android:id="@+id/recovery_title"
                    style="@style/Vpn0wnMonoValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/vpn0wn_recovery_title"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/vpn0wn_rule" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recovery_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/vpn0wn_paper_2"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/vpn0wn_rule"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/recovery_card_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:recoverySnapshot="@{tunnel.recoverySnapshot}"
                    app:recoveryDiagnostics="@{tunnel.handshakeDiagnostics}"
                    app:recoveryConfig="@{config}"
                    app:recoveryState="@{tunnel.state}">

                    <LinearLayout
                        style="@style/Vpn0wnDetailRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Vpn0wnConfigRowLabel"
                            android:text="@string/vpn0wn_recovery_status_label" />

                        <TextView
                            android:id="@+id/recovery_status"
                            style="@style/Vpn0wnMonoValueText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="13sp"
                            tools:text="@string/vpn0wn_recovery_unknown" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Vpn0wnDetailRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Vpn0wnConfigRowLabel"
                            android:text="@string/vpn0wn_recovery_attempts_label" />

                        <TextView
                            android:id="@+id/recovery_counts_attempts"
