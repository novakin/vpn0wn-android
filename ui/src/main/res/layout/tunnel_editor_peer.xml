<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <import type="com.vpn0wn.android.widget.KeyInputFilter" />

        <import type="com.vpn0wn.android.databinding.BindingAdapters" />

        <variable
            name="collection"
            type="androidx.databinding.ObservableList&lt;com.vpn0wn.android.viewmodel.PeerProxy&gt;" />

        <variable
            name="item"
            type="com.vpn0wn.android.viewmodel.PeerProxy" />

        <variable
            name="fragment"
            type="com.vpn0wn.android.fragment.TunnelEditorFragment" />
    </data>

    <!-- Peer FieldGroup card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardElevation="0dp"
        app:contentPadding="0dp"
        app:strokeColor="@color/vpn0wn_rule"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Peer header: PEER #01 + remove button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/vpn0wn_paper_3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/peer_title"
                    style="@style/Vpn0wnLabelText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/peer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/delete"
                    style="@style/Vpn0wnPillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nextFocusDown="@id/public_key_text"
                    android:nextFocusForward="@id/public_key_text"
                    android:onClick="@{() -> item.unbind()}"
                    android:text="remove"
                    android:textColor="@color/vpn0wn_error" />
            </LinearLayout>

            <!-- PUBLIC KEY -->
            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="PUBLIC KEY" />

                <EditText
                    android:id="@+id/public_key_text"
                    style="@style/Vpn0wnEditorField"
                    android:hint="paste base64 key"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:nextFocusUp="@id/delete"
                    android:nextFocusDown="@id/pre_shared_key_text"
                    android:nextFocusForward="@id/pre_shared_key_text"
                    android:text="@={item.publicKey}"
                    app:filter="@{KeyInputFilter.newInstance()}" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/vpn0wn_rule" />

            <!-- PRESHARED KEY -->
            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="PRESHARED KEY" />

                <EditText
                    android:id="@+id/pre_shared_key_text"
                    style="@style/Vpn0wnEditorField"
                    android:hint="@string/hint_optional"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions|textPassword"
                    android:nextFocusUp="@id/public_key_text"
                    android:nextFocusDown="@id/endpoint_text"
                    android:nextFocusForward="@id/endpoint_text"
                    android:onClick="@{fragment::onKeyClick}"
                    android:text="@={item.preSharedKey}"
                    app:filter="@{KeyInputFilter.newInstance()}"
                    app:onFocusChange="@{fragment::onKeyFocusChange}" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/vpn0wn_rule" />

            <!-- ENDPOINT -->
            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="ENDPOINT" />

                <EditText
                    android:id="@+id/endpoint_text"
                    style="@style/Vpn0wnEditorField"
                    android:hint="host:port"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:nextFocusUp="@id/pre_shared_key_text"
                    android:nextFocusDown="@id/allowed_ips_text"
                    android:nextFocusForward="@id/allowed_ips_text"
                    android:text="@={item.endpoint}" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/vpn0wn_rule" />

            <!-- ALLOWED IPs -->
            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="ALLOWED IPs" />

                <EditText
                    android:id="@+id/allowed_ips_text"
                    style="@style/Vpn0wnEditorField"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:nextFocusUp="@id/endpoint_text"
                    android:nextFocusDown="@id/selected_checkbox"
                    android:nextFocusForward="@id/selected_checkbox"
                    android:text="@={item.allowedIps}" />

                <!-- Exclude private IPs toggle — keep as-is -->
                <CheckBox
                    android:id="@+id/selected_checkbox"
                    style="@style/Vpn0wnCheckboxText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="@={item.excludingPrivateIps}"
                    android:nextFocusDown="@id/persistent_keepalive_text"
                    android:nextFocusForward="@id/persistent_keepalive_text"
                    android:text="@string/exclude_private_ips"
                    android:visibility="@{item.ableToExcludePrivateIps ? View.VISIBLE : View.GONE}" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/vpn0wn_rule" />

            <!-- PERSISTENT KEEPALIVE -->
            <LinearLayout
                style="@style/Vpn0wnDetailRow"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnConfigRowLabel"
                    android:text="PERSISTENT KEEPALIVE" />

                <EditText
                    android:id="@+id/persistent_keepalive_text"
                    style="@style/Vpn0wnEditorField"
                    android:hint="@string/hint_optional_discouraged"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:nextFocusUp="@id/selected_checkbox"
                    android:nextFocusDown="@id/endpoint_text"
                    android:nextFocusForward="@id/endpoint_text"
                    android:text="@={item.persistentKeepalive}" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
