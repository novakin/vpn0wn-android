<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.wireguard.android.model.ObservableTunnel" />

        <import type="com.wireguard.android.databinding.BindingAdapters" />

        <variable
            name="fragment"
            type="com.wireguard.android.fragment.TunnelListFragment" />

        <variable
            name="rowConfigurationHandler"
            type="com.wireguard.android.databinding.ObservableKeyedRecyclerViewAdapter.RowConfigurationHandler" />

        <variable
            name="tunnels"
            type="com.wireguard.android.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tunnl_paper"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/home_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/tunnl_paper_2"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TunnlLabelText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        app:homeHeaderTunnels="@{tunnels}"
                        tools:text="Vpn0wn · 3 CONFIGURED · ACTIVE" />

                    <!-- Keep compact glyph spacing without overlapping the 48dp native touch targets. -->
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:alpha="0.38"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/search"
                        android:enabled="@{false}"
                        android:padding="16dp"
                        android:paddingStart="26dp"
                        android:paddingEnd="6dp"
                        app:srcCompat="@drawable/ic_tunnl_search"
                        app:tint="@color/tunnl_ink_2" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/log_viewer_title"
                        android:onClick="@{fragment::onOpenLogs}"
                        android:padding="16dp"
                        app:srcCompat="@drawable/ic_tunnl_logs"
                        app:tint="@color/tunnl_ink_2" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/settings"
                        android:onClick="@{fragment::onOpenSettings}"
                        android:padding="16dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="26dp"
                        app:srcCompat="@drawable/ic_tunnl_settings"
                        app:tint="@color/tunnl_ink_2" />
                </LinearLayout>

                <TextView
                    style="@style/TunnlHomeTopBarTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/tunnl_list_title"
                    android:textColor="@color/tunnl_ink" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tunnl_rule" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/tunnl_paper_2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <View
                    app:homeProtectionDotTunnels="@{tunnels}"
                    android:layout_width="8dp"
                    android:layout_height="8dp" />

                <TextView
                    style="@style/TunnlStatusStripText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:homeProtectionTunnels="@{tunnels}"
                    tools:text="PROTECTED" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/TunnlStatusStripText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{BindingAdapters.homeExitIpLabel(tunnels)}"
                    android:textColor="@color/tunnl_ink_3"
                    tools:text="EXIT IP · 2.58.53.241" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tunnl_rule" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tunnel_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:nextFocusDown="@id/create_fab"
                    android:nextFocusForward="@id/create_fab"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="@{tunnels.size() > 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
                    app:configurationHandler="@{rowConfigurationHandler}"
                    app:items="@{tunnels}"
                    app:layout="@{@layout/tunnel_list_item}"
                    tools:itemCount="12"
                    tools:listitem="@layout/tunnel_list_item" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:visibility="@{tunnels.size() == 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
                    tools:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/logo_placeholder"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="20dp"
                        android:alpha="0.3333333"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        style="@style/TunnlEmptyStateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/tunnel_list_placeholder_margin"
                        android:layout_marginEnd="@dimen/tunnel_list_placeholder_margin"
                        android:text="@string/tunnel_list_placeholder" />
                </LinearLayout>
            </FrameLayout>


            <TextView
                android:id="@+id/create_fab"
                style="@style/TunnlLabelText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/tunnl_add_tunnel_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/tunnel_list"
                android:text="@string/tunnl_add_tunnel"
                android:textColor="@color/tunnl_ink_3" />
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
