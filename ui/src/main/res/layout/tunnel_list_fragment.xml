<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.vpn0wn.android.model.ObservableTunnel" />

        <import type="com.vpn0wn.android.databinding.BindingAdapters" />

        <variable
            name="fragment"
            type="com.vpn0wn.android.fragment.TunnelListFragment" />

        <variable
            name="rowConfigurationHandler"
            type="com.vpn0wn.android.databinding.ObservableKeyedRecyclerViewAdapter.RowConfigurationHandler" />

        <variable
            name="tunnels"
            type="com.vpn0wn.android.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vpn0wn_paper"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/home_scroll_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/home_app_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/vpn0wn_paper"
                    android:stateListAnimator="@null"
                    app:elevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_scrollFlags="scroll|enterAlways">

                        <LinearLayout
                            android:id="@+id/home_header_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/vpn0wn_paper"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="2dp"
                            android:paddingBottom="12dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp">

                                <TextView
                                    android:id="@+id/home_header_summary"
                                    style="@style/Vpn0wnHomeHeaderText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    app:homeHeaderTunnels="@{tunnels}"
                                    tools:text="vpnøwn · 3 configured" />

                                <LinearLayout
                                    android:id="@+id/home_header_actions"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:orientation="horizontal">

                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/home_search"
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:alpha="0.38"
                                        android:background="@android:color/transparent"
                                        android:contentDescription="@string/search"
                                        android:enabled="@{false}"
                                        android:padding="12dp"
                                        app:srcCompat="@drawable/ic_vpn0wn_search"
                                        app:tint="@color/vpn0wn_ink" />

                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/home_servers"
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="@string/vpn0wn_servers_title"
                                        android:onClick="@{fragment::onOpenServers}"
                                        android:padding="12dp"
                                        app:srcCompat="@drawable/ic_vpn0wn_server"
                                        app:tint="@color/vpn0wn_ink" />

                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/home_logs"
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="@string/log_viewer_title"
                                        android:onClick="@{fragment::onOpenLogs}"
                                        android:padding="12dp"
                                        app:srcCompat="@drawable/ic_vpn0wn_home_logs"
                                        app:tint="@color/vpn0wn_ink" />

                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/home_settings"
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="@string/settings"
                                        android:onClick="@{fragment::onOpenSettings}"
                                        android:padding="12dp"
                                        app:srcCompat="@drawable/ic_vpn0wn_settings"
                                        app:tint="@color/vpn0wn_ink" />
                                </LinearLayout>

                                <androidx.constraintlayout.helper.widget.Flow
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    app:constraint_referenced_ids="home_header_summary,home_header_actions"
                                    app:flow_horizontalStyle="spread_inside"
                                    app:flow_verticalAlign="center"
                                    app:flow_verticalGap="8dp"
                                    app:flow_wrapMode="chain"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <TextView
                                style="@style/Vpn0wnHomeTopBarTitleText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/vpn0wn_list_title"
                                android:textColor="@color/vpn0wn_ink" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/selection_header_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/vpn0wn_paper_2"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <androidx.appcompat.widget.AppCompatImageButton
                                    android:id="@+id/selection_close"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/vpn0wn_selection_exit"
                                    android:onClick="@{fragment::onExitSelection}"
                                    android:padding="16dp"
                                    app:srcCompat="@drawable/ic_vpn0wn_close"
                                    app:tint="@color/vpn0wn_ink_2" />

                                <TextView
                                    style="@style/Vpn0wnLabelText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/vpn0wn_selection_mode" />

                                <androidx.appcompat.widget.AppCompatImageButton
                                    android:id="@+id/selection_delete"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/vpn0wn_selection_delete"
                                    android:onClick="@{fragment::onDeleteSelection}"
                                    android:padding="16dp"
                                    app:srcCompat="@drawable/ic_vpn0wn_trash"
                                    app:tint="@color/vpn0wn_ink_2" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/selection_title"
                                style="@style/Vpn0wnTopBarTitleText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/vpn0wn_rule" />

                        <LinearLayout
                            android:id="@+id/home_status_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/vpn0wn_paper"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:visibility="gone"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:id="@+id/home_connection_group"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingEnd="12dp">

                                <View
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    app:homeProtectionDotTunnels="@{tunnels}" />

                                <TextView
                                    android:id="@+id/home_connection_label"
                                    style="@style/Vpn0wnHomeConnectionText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    app:homeProtectionTunnels="@{tunnels}"
                                    tools:text="VPN connected" />
                            </LinearLayout>

                            <View
                                android:id="@+id/home_status_divider"
                                android:layout_width="1dp"
                                android:layout_height="26dp"
                                android:background="@color/vpn0wn_rule" />

                            <LinearLayout
                                android:id="@+id/home_endpoint_group"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end|center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="14dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/home_endpoint_label"
                                        style="@style/Vpn0wnHomeSecondaryText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="end"
                                        android:text="@string/vpn0wn_home_endpoint" />

                                    <TextView
                                        android:id="@+id/home_endpoint_host"
                                        style="@style/Vpn0wnHomeStatValueText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:gravity="end"
                                        android:singleLine="true"
                                        android:text="@{BindingAdapters.homeEndpointHost(tunnels)}"
                                        tools:text="198.51.100.42" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/home_endpoint_icon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="12dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_vpn0wn_external" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/selection_status_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@color/vpn0wn_paper_2"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/selection_status"
                                style="@style/Vpn0wnStatusStripText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/selection_all"
                                style="@style/Vpn0wnPillButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="48dp"
                                android:minHeight="48dp"
                                android:onClick="@{fragment::onSelectAll}"
                                android:text="@string/select_all" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/vpn0wn_rule" />

                    </LinearLayout>
                </com.google.android.material.appbar.AppBarLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tunnel_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:nextFocusDown="@id/create_fab"
                    android:nextFocusForward="@id/create_fab"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="@{tunnels.size() > 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    app:configurationHandler="@{rowConfigurationHandler}"
                    app:items="@{tunnels}"
                    app:layout="@{@layout/tunnel_list_item}"
                    tools:itemCount="12"
                    tools:listitem="@layout/tunnel_list_item" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/home_empty_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/vpn0wn_license_notice_background"
                    android:fillViewport="true"
                    android:visibility="@{tunnels != null &amp;&amp; tunnels.size() == 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    tools:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/vpn0wn_home_empty_padding"
                        android:paddingBottom="@dimen/vpn0wn_home_empty_padding"
                        app:homeEmptyAppBar="@{homeAppBar}">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/logo_placeholder"
                            android:layout_width="112dp"
                            android:layout_height="112dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="16dp"
                            android:alpha="0.3333333"
                            android:importantForAccessibility="no"
                            android:src="@drawable/vpnown_symbol" />

                        <TextView
                            android:id="@+id/home_empty_placeholder"
                            style="@style/Vpn0wnEmptyStateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/tunnel_list_placeholder_margin"
                            android:layout_marginEnd="@dimen/tunnel_list_placeholder_margin"
                            android:breakStrategy="balanced"
                            android:gravity="center"
                            android:maxWidth="280dp"
                            android:text="@string/tunnel_list_placeholder" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/create_fab"
                style="@style/Vpn0wnHomeAddButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="10dp"
                android:foreground="@drawable/vpn0wn_home_corner_ticks"
                android:nextFocusUp="@id/tunnel_list"
                android:text="@string/vpn0wn_add_tunnel" />
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
