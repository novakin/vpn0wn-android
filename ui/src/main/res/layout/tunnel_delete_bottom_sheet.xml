<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/delete_sheet_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tunnl_delete_sheet_background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/tunnl_add_sheet_handle" />

        <TextView
            style="@style/Vpn0wnLabelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tunnl_delete_irreversible"
            android:textColor="@color/tunnl_error" />

        <TextView
            android:id="@+id/delete_sheet_title"
            style="@style/Vpn0wnTopBarTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            style="@style/Vpn0wnLabelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tunnl_delete_no_undo" />

        <TextView
            android:id="@+id/delete_sheet_warning"
            style="@style/Vpn0wnMonoSubText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tunnl_delete_sheet_warning_background"
            android:padding="12dp"
            android:textColor="@color/tunnl_warn"
            android:visibility="gone" />

        <TextView
            android:id="@+id/delete_sheet_names"
            style="@style/Vpn0wnMonoValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tunnl_delete_sheet_item_background"
            android:ellipsize="none"
            android:padding="12dp"
            android:singleLine="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/delete_sheet_cancel"
                style="@style/Vpn0wnLabelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:text="@string/cancel"
                android:textColor="@color/tunnl_ink_2" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/delete_sheet_confirm"
                style="@style/Vpn0wnLabelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:background="@drawable/tunnl_delete_button_background"
                android:padding="12dp"
                android:text="@string/delete"
                android:textColor="@color/tunnl_error" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
