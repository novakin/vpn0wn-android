<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vpn0wn_paper"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/vpn0wn_add_sheet_handle" />

        <TextView
            style="@style/Vpn0wnLabelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/vpn0wn_add_sheet_title"
            android:textColor="@color/vpn0wn_ink_3" />

        <LinearLayout
            android:id="@+id/create_from_qrcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="74dp"
            android:background="@drawable/vpn0wn_add_sheet_option_accent_background"
            android:importantForAccessibility="yes"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:nextFocusDown="@id/create_from_file"
            android:nextFocusForward="@id/create_from_file"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:importantForAccessibility="no"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_vpn0wn_qr"
                app:tint="@color/vpn0wn_signal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnMonoValueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_from_qr_code"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Vpn0wnMonoSubText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/vpn0wn_add_sheet_qr_subtitle" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:importantForAccessibility="no"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_vpn0wn_chevron_right"
                app:tint="@color/vpn0wn_ink_3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/create_from_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="74dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/vpn0wn_add_sheet_option_background"
            android:importantForAccessibility="yes"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:nextFocusUp="@id/create_from_qrcode"
            android:nextFocusDown="@id/create_empty"
            android:nextFocusForward="@id/create_empty"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:importantForAccessibility="no"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_vpn0wn_file"
                app:tint="@color/vpn0wn_ink_2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnMonoValueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_from_file"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Vpn0wnMonoSubText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/vpn0wn_add_sheet_file_subtitle" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:importantForAccessibility="no"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_vpn0wn_chevron_right"
                app:tint="@color/vpn0wn_ink_3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/create_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="74dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/vpn0wn_add_sheet_option_background"
            android:importantForAccessibility="yes"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:nextFocusUp="@id/create_from_file"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:importantForAccessibility="no"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_vpn0wn_key"
                app:tint="@color/vpn0wn_ink_2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <TextView
                    style="@style/Vpn0wnMonoValueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_empty"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Vpn0wnMonoSubText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/vpn0wn_add_sheet_manual_subtitle" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:importantForAccessibility="no"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_vpn0wn_chevron_right"
                app:tint="@color/vpn0wn_ink_3" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
