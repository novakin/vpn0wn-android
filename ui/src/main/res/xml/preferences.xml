<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="settings">

    <PreferenceCategory
        android:key="settings_connection"
        android:layout="@layout/tunnl_preference_category"
        android:title="@string/tunnl_settings_section_connection">

        <com.wireguard.android.preference.KernelModuleEnablerPreference
            android:icon="@drawable/ic_tunnl_server"
            android:key="kernel_module_enabler"
            android:singleLineTitle="false"
            android:layout="@layout/tunnl_preference_item" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_tunnl_refresh"
            android:key="restore_on_boot"
            android:layout="@layout/tunnl_preference_item"
            android:singleLineTitle="false"
            android:summaryOff="@string/restore_on_boot_summary_off"
            android:summaryOn="@string/restore_on_boot_summary_on"
            android:title="@string/restore_on_boot_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_tunnl_server"
            android:key="multiple_tunnels"
            android:layout="@layout/tunnl_preference_item"
            android:singleLineTitle="false"
            android:summaryOff="@string/multiple_tunnels_summary_off"
            android:summaryOn="@string/multiple_tunnels_summary_on"
            android:title="@string/multiple_tunnels_title" />

        <com.wireguard.android.preference.ToolsInstallerPreference
            android:icon="@drawable/ic_tunnl_key"
            android:key="tools_installer"
            android:singleLineTitle="false"
            android:layout="@layout/tunnl_preference_item" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="settings_control"
        android:layout="@layout/tunnl_preference_category"
        android:title="@string/tunnl_settings_section_control">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_tunnl_share"
            android:key="allow_remote_control_intents"
            android:layout="@layout/tunnl_preference_item"
            android:singleLineTitle="false"
            android:summaryOff="@string/allow_remote_control_intents_summary_off"
            android:summaryOn="@string/allow_remote_control_intents_summary_on"
            android:title="@string/allow_remote_control_intents_title" />

        <com.wireguard.android.preference.QuickTilePreference
            android:icon="@drawable/ic_tunnl_settings"
            android:key="quick_tile"
            android:singleLineTitle="false"
            android:layout="@layout/tunnl_preference_item" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="settings_data"
        android:layout="@layout/tunnl_preference_category"
        android:title="@string/tunnl_settings_section_data">

        <com.wireguard.android.preference.ZipExporterPreference
            android:icon="@drawable/ic_tunnl_file"
            android:key="zip_exporter"
            android:singleLineTitle="false"
            android:layout="@layout/tunnl_preference_item" />

        <Preference
            android:icon="@drawable/ic_tunnl_logs"
            android:key="log_viewer"
            android:layout="@layout/tunnl_preference_item"
            android:singleLineTitle="false"
            android:summary="@string/log_viewer_pref_summary"
            android:title="@string/log_viewer_pref_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="settings_appearance"
        android:layout="@layout/tunnl_preference_category"
        android:title="@string/tunnl_settings_section_appearance">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_tunnl_settings"
            android:key="dark_theme"
            android:layout="@layout/tunnl_preference_item"
            android:singleLineTitle="false"
            android:summaryOff="@string/dark_theme_summary_off"
            android:summaryOn="@string/dark_theme_summary_on"
            android:title="@string/dark_theme_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="settings_about"
        android:layout="@layout/tunnl_preference_category"
        android:title="@string/tunnl_settings_section_about">

        <com.wireguard.android.preference.VersionPreference
            android:icon="@mipmap/ic_launcher"
            android:key="version"
            android:singleLineTitle="false"
            android:layout="@layout/tunnl_preference_item" />

        <com.wireguard.android.preference.DonatePreference
            android:icon="@drawable/ic_tunnl_share"
            android:layout="@layout/tunnl_preference_item"
            android:singleLineTitle="false" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
