{
  "colors": {
    "background": "#071220",
    "secondaryBackground": "#0A1727",
    "surface": "#162436",
    "accent": "#2ABFF7",
    "secondaryAccent": "#68C6FD",
    "border": "#233B54",
    "activeBorder": "#3E5B78",
    "text": "#FAFAFA",
    "secondaryText": "#C9D5E3",
    "mutedText": "#94AECB"
  },
  "gradient": {
    "type": "linear",
    "direction": "top-to-bottom",
    "stops": [
      {
        "offset": 0,
        "color": "#68C6FD"
      },
      {
        "offset": 1,
        "color": "#2ABFF7"
      }
    ],
    "use": "display symbol and wordmark Ø only"
  },
  "typography": {
    "family": "Sora",
    "weights": {
      "wordmark": 800,
      "heading": 600,
      "label": 500,
      "body": 400
    }
  },
  "usage": {
    "microMaximumPx": 16,
    "normalMinimumPx": 24,
    "buttonText": "#071220",
    "buttonBackground": "#2ABFF7",
    "focus": "#2ABFF7"
  }
}
